___TESTS___

scenarios:
- name: Within a CMP
  code: |-
    // ---------------------------------------------------------------------
    // Test 1: "Within a CMP" passes true
    // ---------------------------------------------------------------------
    let initArgs;
    mock('copyFromWindow', () => undefined);
    mock('setInWindow', () => true);
    mock('injectScript', (url, onSuccess) => onSuccess());
    mock('callInWindow', (path, a, b) => {
      if (path === 'consenTag.init') initArgs = [a, b];
    });

    runCode({ containerId: 'TEST', consentSignalType: 'true' });

    assertThat(initArgs[0]).isEqualTo({ containerId: 'TEST', silentMode: true });
    assertThat(initArgs[1]).isEqualTo(true);
    assertApi('gtmOnSuccess').wasCalled();
- name: NOT within a CMP - defaults to true
  code: |
    // ---------------------------------------------------------------------
    // Test 2: "NOT within a CMP" with no window value passes { GDPR_CONSENT_85: true }
    // ---------------------------------------------------------------------
    let initArgs;
    mock('copyFromWindow', () => undefined);
    mock('setInWindow', () => true);
    mock('injectScript', (url, onSuccess) => onSuccess());
    mock('callInWindow', (path, a, b) => {
      if (path === 'consenTag.init') initArgs = [a, b];
    });

    runCode({ containerId: 'TEST', consentSignalType: '{GDPR_CONSENT_85}' });

    assertThat(initArgs[1]).isEqualTo({ GDPR_CONSENT_85: true });
    assertApi('gtmOnSuccess').wasCalled();
- name: NOT within a CMP - passes value when set
  code: |-
    // ---------------------------------------------------------------------
    // Test 3: "NOT within a CMP" uses window.GDPR_CONSENT_85 when set
    // ---------------------------------------------------------------------
    let initArgs;
    mock('copyFromWindow', (key) => key === 'GDPR_CONSENT_85' ? 'TC_STRING' : undefined);
    mock('setInWindow', () => true);
    mock('injectScript', (url, onSuccess) => onSuccess());
    mock('callInWindow', (path, a, b) => {
      if (path === 'consenTag.init') initArgs = [a, b];
    });

    runCode({ containerId: 'TEST', consentSignalType: '{GDPR_CONSENT_85}' });

    assertThat(initArgs[1]).isEqualTo({ GDPR_CONSENT_85: 'TC_STRING' });
- name: Unrecognised saved value fallback
  code: |-
    // ---------------------------------------------------------------------
    // Test 4: An unrecognised saved value falls back to "NOT within a CMP"
    // ---------------------------------------------------------------------
    let initArgs;
    mock('copyFromWindow', () => undefined);
    mock('setInWindow', () => true);
    mock('injectScript', (url, onSuccess) => onSuccess());
    mock('callInWindow', (path, a, b) => {
      if (path === 'consenTag.init') initArgs = [a, b];
    });

    runCode({ containerId: 'TEST', consentSignalType: 'auto' });

    assertThat(initArgs[1]).isEqualTo({ GDPR_CONSENT_85: true });
- name: consentag_data created only when it doesn't exist
  code: |-
    // ---------------------------------------------------------------------
    // Test 5: consentag_data is created only when it doesn't exist
    // ---------------------------------------------------------------------
    mock('copyFromWindow', (key) => key === 'consentag_data' ? [] : undefined);
    mock('injectScript', (url, onSuccess) => onSuccess());
    mock('callInWindow', () => {});

    runCode({ containerId: 'TEST', consentSignalType: 'true' });

    assertApi('setInWindow').wasNotCalled();
- name: Script failure
  code: |-
    // ---------------------------------------------------------------------
    // Test 6: Script load failure reports gtmOnFailure
    // ---------------------------------------------------------------------
    mock('copyFromWindow', () => undefined);
    mock('setInWindow', () => true);
    mock('injectScript', (url, onSuccess, onFailure) => onFailure());

    runCode({ containerId: 'TEST', consentSignalType: 'true' });

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();


