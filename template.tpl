___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// =====================================================================
// consenTag GTM template – Code tab
// Fields: containerId, consentSignalType (true | {GDPR_CONSENT_85})
// =====================================================================

const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const copyFromWindow = require('copyFromWindow');
const callInWindow = require('callInWindow');

// consenTag version shown in the URL
const SCRIPT_URL = 'https://consentag.eu/public/5.0.0/consenTag.js';

// 1. Ensure window.consentag_data is initialised
if (!copyFromWindow('consentag_data')) {
  setInWindow('consentag_data', []);
}

// 2. Consent parameter for consenTag.init (second argument)
//    "within a CMP"     -> true: consent already checked, bypass
//    "NOT within a CMP" -> { GDPR_CONSENT_85: ... }: consenTag evaluates consent
//    Anything else (e.g. a tag saved with an old option) is treated as
//    "NOT within a CMP", so consenTag still checks consent.
let consentParam;

if (data.consentSignalType === 'true') {
  consentParam = true;
} else {
  const windowConsent = copyFromWindow('GDPR_CONSENT_85');
  consentParam = { GDPR_CONSENT_85: windowConsent !== undefined ? windowConsent : true };
}

// 3. Inject consenTag and call init
injectScript(SCRIPT_URL, () => {
  const config = {
    containerId: data.containerId,
    silentMode: true
  };
  callInWindow('consenTag.init', config, consentParam);
  data.gtmOnSuccess();
}, data.gtmOnFailure, SCRIPT_URL);


